module comp16bit(a,b,lt,gt,eq);
parameter bit=16;
input [bit-1:0]a,b;
output reg lt,gt,eq;
always@(*)begin
lt=0;gt=0;eq=0;
if(a>b)gt=1;
else if(a<b) lt=1;
else eq=1;
end
endmodule

