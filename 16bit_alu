module alu16bit(input [15:0]a,[15:0]b,output sign,zero,carry,parity,overflow,[15:0]out);
assign {carry,out}=a+b;
assign sign=out[15];
assign zero= ~|out;
assign parity=~^out;
assign overflow=(a[15]&b[15]&~out[15])|(~a[15]&~b[15]&out[15]);
endmodule

